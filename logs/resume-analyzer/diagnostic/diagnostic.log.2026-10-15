n": "Высшее в маркетинге или смежных", "experience": "От 2 лет в digital-маркетинге. B2B опыт", "keywords": ["digital-маркетинг", "контент", "SEO", "контекстная реклама", "аналитика", "email-маркетинг", "SMM", "воронки"], "stop_factors": [], "comment": "Маркетолог для B2B-направления", "is_active": true}, {"id": "ed89f8f6-f00e-49ba-8886-01a76989a8ab", "cluster_id": "d6b7c438-a72a-4cf9-aacd-d7b3a2b5a391", "position_name": "Менеджер по продажам B2B", "education": "Высшее", "experience": "От 2 лет B2B-продаж. Опыт с длинным циклом сделки", "keywords": ["B2B продажи", "холодные звонки", "CRM", "переговоры", "коммерческие предложения", "воронка продаж", "демо"], "stop_factors": ["Нет опыта B2B"], "comment": "Менеджер по продажам для корпоративного сегмента", "is_active": true}, {"id": "c80af852-8a20-43ff-be2f-40a4edbaed32", "cluster_id": "d6b7c438-a72a-4cf9-aacd-d7b3a2b5a391", "position_name": "Специалист по документообороту", "education": "Высшее", "experience": "От 1 года работы с электронным документооборотом", "keywords": ["документооборот", "СЭД", "архив", "договоры", "Диадок", "1С:Документооборот", "делопроизводство"], "stop_factors": [], "comment": "Специалист по СЭД для ведения договорной базы", "is_active": true}, {"id": "09d0a378-e0fd-401f-a292-ccb300bcafc4", "cluster_id": "d6b7c438-a72a-4cf9-aacd-d7b3a2b5a391", "position_name": "Специалист технической поддержки", "education": "Среднее специальное или высшее техническое", "experience": "От 1 года в поддержке. Работа с обращениями", "keywords": ["техническая поддержка", "обращения", "диагностика", "SQL", "Linux", "клиентоориентированность", "Zendesk"], "stop_factors": [], "comment": "Специалист поддержки для корпоративных клиентов", "is_active": true}, {"id": "0e08e7b9-f4b9-4967-bfa8-3f6e6b013b26", "cluster_id": "d6b7c438-a72a-4cf9-aacd-d7b3a2b5a391", "position_name": "Технический писатель", "education": "Высшее техническое или гуманитарное", "experience": "От 2 лет технической документации", "keywords": ["техническая документация", "API документация", "инструкции", "руководства", "Markdown", "Swagger", "Confluence"], "stop_factors": [], "comment": "Техписатель для документации продукта и API", "is_active": true}, {"id": "2d13c5b9-7ddd-4b24-ace2-6888b81bf4d8", "cluster_id": "d6b7c438-a72a-4cf9-aacd-d7b3a2b5a391", "position_name": "Финансовый аналитик", "education": "Высшее экономическое или финансовое", "experience": "От 2 лет в фин. анализе. Отчетность и бюджеты", "keywords": ["финансовый анализ", "Excel", "Power BI", "бюджетирование", "P&L", "отчетность", "МСФО", "1С"], "stop_factors": ["Нет знания Excel на продвинутом уровне"], "comment": "Финансовый аналитик для поддержки бизнеса", "is_active": true}, {"id": "b84ddc1f-2613-4233-b9b2-8e81f27b16d6", "cluster_id": "d6b7c438-a72a-4cf9-aacd-d7b3a2b5a391", "position_name": "Юрист", "education": "Высшее юридическое", "experience": "От 3 лет корпоративного права. Договорная работа", "keywords": ["корпоративное право", "договоры", "NDA", "GDPR", "152-ФЗ", "судебная практика", "комплаенс"], "stop_factors": ["Нет высшего юридического"], "comment": "Юрист для сопровождения ИТ-проектов и договоров", "is_active": true}]}, {"id": "bca3f58b-0b9e-40f0-bdc2-c193be30a760", "name": "ИТ-кластер разработки", "track": "трек-2", "comment": "Технические специалисты, работающие над разработкой, эксплуатацией и безопасностью программного обеспечения", "is_active": true, "profiles": [{"id": "2444b500-31c8-4e98-a9fa-f3cee3f6e503", "cluster_id": "bca3f58b-0b9e-40f0-bdc2-c193be30a760", "position_name": "Backend-разработчик", "education": "Высшее техническое в области информатики или программной инженерии", "experience": "От 3 лет коммерческой разработки на Python/Java/Go. Опыт проектирования микросервисов", "keywords": ["Python", "FastAPI", "Django", "PostgreSQL", "Redis", "Docker", "Kafka", "REST API", "микросервисы"], "stop_factors": ["Отсутствие коммерческого опыта", "Отказ от онбординга в офисе"], "comment": "Ищем сильного бэкендера для высокона