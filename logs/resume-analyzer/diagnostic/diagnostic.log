n"], "title": "ModelRating", "type": "object", "additionalProperties": false}, "options": {"num_ctx": 16384, "num_predict": 8192, "temperature": 0.0}, "message_ru": "[ДИАГ] Полный запрос к модели", "level": "DEBUG", "timestamp": "2026-10-15T05:11:33.283907"}
