# Copy to .env and set unique credentials before starting.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
# Legacy v1 switches below are retained only for archived tests; the current stack ignores them.
RABBITMQ_ENABLED=false
# Only in broker mode: false hands analysis jobs to a future native AMQP consumer.
RANK_BRIDGE_ENABLED=false
# RabbitMQ settings are used only when RABBITMQ_ENABLED=true.
RABBITMQ_USER=hr_dam
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
RABBITMQ_URL=
RESUME_ANALYZER_CALLBACK_TOKEN=
RESUME_SPOOL_DIR=.qa/resume-spool
QUEUE_RETRY_DELAY_MS=10000
# Current HTTP analyzer, used by both processing modes while the bridge is enabled.
RESUME_ANALYZER_URL=
RESUME_ANALYZER_READY_URL=
RESUME_ANALYZER_TIMEOUT_MS=900000
# HTTP /rank retries and initial backoff.
ANALYSIS_MAX_RETRIES=2
ANALYSIS_RETRY_DELAY_MS=15000
# Default: included Ollama container with NVIDIA GPU access.
OLLAMA_BASE_URL=http://ollama:11434
# Native Ollama mode: add -f docker-compose.local-ollama.yml after -f docker-compose.yml.
# This address overrides OLLAMA_BASE_URL only in native mode; a LAN server URL also works.
LOCAL_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# Host-RAM prompt cache limit for bundled Ollama (MiB); 0 disables caching.
OLLAMA_PROMPT_CACHE_MB=1024
OLLAMA_TIMEOUT_SECONDS=180
RANK_TIMEOUT_SECONDS=840
MODEL_PROBE_TIMEOUT_SECONDS=60
MODEL_PROBE_INTERVAL_SECONDS=15
POSTGRES_PORT=5432
POSTGRES_DB=candidate_matching
POSTGRES_USER=candidate_matching
POSTGRES_PASSWORD=

PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

S3_PORT=8333
S3_ENDPOINT=http://127.0.0.1:8333
S3_INTERNAL_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Processing: npm run prepare:environment generates missing credentials and RSA keys.
# Only Nginx publishes a port. PostgreSQL, S3 and RabbitMQ stay private.
APP_ORIGIN=http://localhost:3000
RABBITMQ_ADMIN_USER=hr_admin
RABBITMQ_ADMIN_PASSWORD=
GUEST_AMQP_PASSWORD=
AUTHORIZED_AMQP_PASSWORD=
PREPARE_AMQP_PASSWORD=
EVALUATE_AMQP_PASSWORD=
GUEST_S3_ACCESS_KEY=
GUEST_S3_SECRET_KEY=
S3_INIT_ACCESS_KEY=
S3_INIT_SECRET_KEY=
# Optional images delivered by the parser/evaluator branch. Enable --profile processing.
PREPARE_IMAGE=hr-dam-resume-parser:local
EVALUATE_IMAGE=hr-dam-resume-evaluator:local
# Host paths for direct Node development; Compose uses Docker secrets instead.
AUTH_PRIVATE_KEY_FILE=.secrets/auth-private.pem
AUTH_PUBLIC_KEY_FILE=.secrets/auth-public.pem
GUEST_JOB_PRIVATE_KEY_FILE=.secrets/guest-job-private.pem
GUEST_JOB_PUBLIC_KEY_FILE=.secrets/guest-job-public.pem
AUTHORIZED_JOB_PRIVATE_KEY_FILE=.secrets/authorized-job-private.pem
AUTHORIZED_JOB_PUBLIC_KEY_FILE=.secrets/authorized-job-public.pem
GUEST_COOKIE_PRIVATE_KEY_FILE=.secrets/guest-cookie-private.pem
GUEST_COOKIE_PUBLIC_KEY_FILE=.secrets/guest-cookie-public.pem

# Processing bounds: guest lifetime <=24h and results <=2h. Values in milliseconds.
GUEST_ABSOLUTE_TTL_MS=86400000
GUEST_RESULT_TTL_MS=7200000
GUEST_UPLOAD_CONCURRENCY=3
PROCESSING_TIMEOUT_MS=1800000
UPLOAD_TIMEOUT_MS=600000

# Keep this hostname stable when reusing an existing RabbitMQ volume.
RABBITMQ_NODE_HOSTNAME=rabbitmq
