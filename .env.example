# Copy to .env and set unique credentials before starting.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
# Необязательная модель: профиль docker-ollama или docker-compose.local-ollama.yml.
LOCAL_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_PROMPT_CACHE_MB=1024

POSTGRES_PORT=5432
POSTGRES_DB=candidate_matching
POSTGRES_USER=candidate_matching
POSTGRES_PASSWORD=

PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

S3_INTERNAL_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Processing: npm run prepare:environment generates missing credentials and RSA keys.
# Only Nginx publishes a port. PostgreSQL, S3 and RabbitMQ stay private.
APP_ORIGIN=http://localhost:3000
RABBITMQ_ADMIN_USER=hr_admin
RABBITMQ_ADMIN_PASSWORD=
GUEST_AMQP_PASSWORD=
AUTHORIZED_AMQP_PASSWORD=
PREPARE_AMQP_PASSWORD=
EVALUATE_AMQP_PASSWORD=
GUEST_S3_ACCESS_KEY=
GUEST_S3_SECRET_KEY=
S3_INIT_ACCESS_KEY=
S3_INIT_SECRET_KEY=
# Optional images delivered by the parser/evaluator branch. Enable --profile processing.
PREPARE_IMAGE=hr-dam-resume-parser:local
EVALUATE_IMAGE=hr-dam-resume-evaluator:local
# Host paths for direct Node development; Compose uses Docker secrets instead.
AUTH_PRIVATE_KEY_FILE=.secrets/auth-private.pem
AUTH_PUBLIC_KEY_FILE=.secrets/auth-public.pem
GUEST_JOB_PRIVATE_KEY_FILE=.secrets/guest-job-private.pem
GUEST_JOB_PUBLIC_KEY_FILE=.secrets/guest-job-public.pem
AUTHORIZED_JOB_PRIVATE_KEY_FILE=.secrets/authorized-job-private.pem
AUTHORIZED_JOB_PUBLIC_KEY_FILE=.secrets/authorized-job-public.pem
GUEST_COOKIE_PRIVATE_KEY_FILE=.secrets/guest-cookie-private.pem
GUEST_COOKIE_PUBLIC_KEY_FILE=.secrets/guest-cookie-public.pem

# Processing bounds: guest lifetime <=24h and results <=2h. Values in milliseconds.
GUEST_ABSOLUTE_TTL_MS=86400000
GUEST_RESULT_TTL_MS=7200000
GUEST_UPLOAD_CONCURRENCY=3
PROCESSING_TIMEOUT_MS=1800000
UPLOAD_TIMEOUT_MS=600000

# Keep this hostname stable when reusing an existing RabbitMQ volume.
RABBITMQ_NODE_HOSTNAME=rabbitmq
