# Copy to .env and set unique credentials before starting.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
# Two processing modes: false = no RabbitMQ, true = RabbitMQ + HTTP /rank bridge.
RABBITMQ_ENABLED=false
# Select exactly one analyzer adapter: http with bridge=true, or amqp with broker=true and bridge=false.
ANALYZER_ADAPTER=http
RANK_BRIDGE_ENABLED=true
# RabbitMQ settings are used only when RABBITMQ_ENABLED=true.
RABBITMQ_USER=hr_dam
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
RABBITMQ_URL=
RESUME_ANALYZER_CALLBACK_TOKEN=
RESUME_SPOOL_DIR=.qa/resume-spool
QUEUE_RETRY_DELAY_MS=10000
# Current HTTP analyzer, used by both processing modes while the bridge is enabled.
RESUME_ANALYZER_URL=
RESUME_ANALYZER_READY_URL=
RESUME_ANALYZER_CONTACTS_URL=
RESUME_ANALYZER_TIMEOUT_MS=900000
# HTTP /rank retries and initial backoff.
ANALYSIS_MAX_RETRIES=2
ANALYSIS_RETRY_DELAY_MS=15000
# Default: included Ollama container with NVIDIA GPU access.
OLLAMA_BASE_URL=http://ollama:11434
# Native Ollama mode: add -f docker-compose.local-ollama.yml after -f docker-compose.yml.
# This address overrides OLLAMA_BASE_URL only in native mode; a LAN server URL also works.
LOCAL_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
# Host-RAM prompt cache limit for bundled Ollama (MiB); 0 disables caching.
OLLAMA_PROMPT_CACHE_MB=1024
OLLAMA_TIMEOUT_SECONDS=180
RANK_TIMEOUT_SECONDS=840
SHUTDOWN_GRACE_SECONDS=210
MODEL_PROBE_TIMEOUT_SECONDS=10
MODEL_PROBE_INTERVAL_SECONDS=15
POSTGRES_PORT=5432
POSTGRES_DB=candidate_matching
POSTGRES_USER=candidate_matching
POSTGRES_PASSWORD=

PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

S3_PORT=8333
S3_ENDPOINT=http://127.0.0.1:8333
S3_INTERNAL_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY=
S3_SECRET_KEY=
